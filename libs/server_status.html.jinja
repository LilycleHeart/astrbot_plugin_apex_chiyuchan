<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apex Legends 服务器状态</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,300;8..144,400;8..144,500;8..144,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://apexlegendsstatus.com/lib/css/flag-icon.min.css">
<style>
:root {
  --md-primary: #1565C0;
  --md-on-primary: #FFFFFF;
  --md-primary-container: #D4E3FC;
  --md-on-primary-container: #0B1A30;
  --md-secondary-container: #D4E3FC;
  --md-on-secondary-container: #0B1A30;
  --md-surface: #F8FAFF;
  --md-on-surface: #181B20;
  --md-surface-variant: #DDE3F0;
  --md-on-surface-variant: #43474F;
  --md-outline-variant: #C3C6CF;
  --md-surface-container-low: #EFF2F9;
  --md-surface-container: #E9ECF4;
  --md-surface-container-high: #E3E6EE;
  --md-success: #2E7D32;
  --md-warning: #7C5800;
  --md-error: #B3261E;
  --md-shadow-2: 0 1px 2px rgba(0,0,0,0.3), 0 2px 6px 2px rgba(0,0,0,0.15);
}

@media (prefers-color-scheme: dark) {
  :root {
    --md-primary: #A8C8FF;
    --md-on-primary: #002F65;
    --md-primary-container: #00458C;
    --md-on-primary-container: #A8C8FF;
    --md-secondary-container: #324560;
    --md-on-secondary-container: #D4E3FC;
    --md-surface: #101419;
    --md-on-surface: #E0E2E9;
    --md-surface-variant: #43474F;
    --md-on-surface-variant: #C3C6CF;
    --md-outline-variant: #43474F;
    --md-surface-container-low: #1A1D24;
    --md-surface-container: #1E2228;
    --md-surface-container-high: #282C34;
    --md-success: #7DD87D;
    --md-warning: #F5C842;
    --md-error: #F2B8B5;
    --md-shadow-2: 0 1px 2px rgba(0,0,0,0.6), 0 2px 6px 2px rgba(0,0,0,0.4);
  }
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { height: 100%; }

body {
  font-family: 'Roboto Flex', 'Roboto', system-ui, -apple-system, 'Segoe UI', sans-serif;
  background: transparent;
  color: var(--md-on-surface);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 24px;
  -webkit-font-smoothing: antialiased;
}

.card {
  background: var(--md-surface-container-low);
  border-radius: 28px;
  box-shadow: var(--md-shadow-2);
  overflow: hidden;
  max-width: 520px;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 20px 16px 8px 16px;
}

.card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 28px;
  border: 1px solid color-mix(in srgb, var(--md-on-surface) 8%, transparent);
  pointer-events: none;
  z-index: 1;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 16px;
  position: relative;
  z-index: 2;
}

.card-title {
  font-size: 18px;
  font-weight: 500;
  color: var(--md-on-surface);
}

.overall-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 500;
  color: var(--md-on-surface-variant);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.running { background: var(--md-success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-success) 22%, transparent); }
.status-dot.degraded { background: var(--md-warning); box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-warning) 22%, transparent); }
.status-dot.down { background: var(--md-error); box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-error) 22%, transparent); }

.service-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  z-index: 2;
}

.service-group {
  background: var(--md-surface-container);
  border-radius: 14px;
  padding: 10px 14px;
}

.service-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.service-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--md-on-surface);
}

.region-list {
  margin-top: 6px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.region-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 3px 0 3px 20px;
  gap: 8px;
}

.region-name {
  font-size: 11px;
  color: var(--md-on-surface-variant);
  display: flex;
  align-items: center;
  gap: 5px;
  flex: 1;
  min-width: 0;
}

.region-state {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.state-text {
  font-size: 9px;
  color: var(--md-on-surface-variant);
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.region-detail {
  font-size: 11px;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  min-width: 55px;
  text-align: right;
}

.region-detail.good { color: var(--md-success); }
.region-detail.medium { color: var(--md-warning); }
.region-detail.high { color: var(--md-error); }

.flag-icon {
  width: 16px;
  height: 12px;
  flex-shrink: 0;
  vertical-align: middle;
}

.attribution {
  padding: 14px 8px 12px;
  font-size: 11px;
  color: var(--md-on-surface-variant);
  text-align: center;
  line-height: 1.5;
  position: relative;
  z-index: 2;
}

.attribution a {
  color: var(--md-primary);
  text-decoration: none;
  font-weight: 500;
}

.attribution a:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="card">
  <div class="card-header">
    <div class="card-title">服务器状态</div>
    <div class="overall-status">
      <span class="status-dot {{ overall_class }}"></span>
      {{ overall_text }}
    </div>
  </div>

  <div class="service-list">
    {%- for svc in services %}
    <div class="service-group">
      <div class="service-header">
        <span class="status-dot {{ svc.status_class }}"></span>
        <div class="service-name">{{ svc.name }}</div>
      </div>
      {%- if svc.regions %}
      <div class="region-list">
        {%- for r in svc.regions %}
        <div class="region-row">
          <div class="region-name">
            {%- if r.flag_class %}<span class="{{ r.flag_class }} flag-icon"></span>{% endif -%}
            {{ r.name }}
          </div>
          <div class="region-state">
            <span class="status-dot {{ r.state_class }}"></span>
            <span class="state-text">{{ r.state }}</span>
          </div>
          <div class="region-detail {{ r.latency_color }}">{{ r.detail }}</div>
        </div>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>

  <div class="attribution">
    数据来源 <a href="https://apexlegendsstatus.com/" target="_blank" rel="noopener">apexlegendsstatus.com</a> · auth.赤羽真白 · Apex Chiyuchan
  </div>
</div>
</body>
</html>
