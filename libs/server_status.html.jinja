<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Microsoft YaHei','Noto Sans SC',sans-serif;background:transparent;color:{{ text_color }};display:flex;justify-content:center;padding:24px}
.card{width:680px;background:{{ card_color }};border-radius:24px;overflow:hidden;box-shadow:0 10px 20px rgba(0,0,0,.4)}
.header{background:linear-gradient(135deg,{{ card_color }},{{ card2_color }});padding:20px 24px;border-bottom:1px solid {{ outline_color }}}
.header h2{font-size:22px;font-weight:800}
.als-alert{display:flex;align-items:flex-start;gap:8px;padding:12px 24px;background:rgba(255,165,0,.12);border-bottom:1px solid {{ outline_color }};font-size:12px;color:#FFB347;line-height:1.5}
.als-outage{background:rgba(255,69,0,.18);font-weight:700;color:#FF6347}
.warning-icon{flex-shrink:0;font-size:16px}
.als-section{border-bottom:1px solid {{ outline_color }};padding:12px 24px}
.als-section:last-child{border-bottom:none}
.als-section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.als-section-name{font-size:14px;font-weight:700}
.als-pill{font-size:11px;font-weight:700;padding:3px 8px;border-radius:10px}
.pill-down{background:rgba(255,68,68,.18);color:#FF4444}
.pill-unstable{background:rgba(255,165,0,.2);color:#FFB347}
.pill-up{background:rgba(76,229,177,.15);color:#4CE5B1}
.als-row{display:flex;align-items:center;padding:6px 0;gap:8px}
.als-row .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.als-row-name{flex:1;font-size:13px}
.als-row-state{font-size:12px;font-weight:700;width:70px;text-align:center}
.state-unstable{color:#FFB347}
.state-down{color:#FF4444}
.state-up{color:#4CE5B1}
.als-row-rt{font-size:11px;color:{{ muted_color }};width:64px;text-align:right}
.footer{padding:12px 24px;border-top:1px solid {{ outline_color }};font-size:11px;color:{{ muted_color }};text-align:center;line-height:1.6}
</style>
</head>
<body>
<div class="card">
<div class="header"><h2>Apex 服务器状态</h2></div>
{% if alert_banner %}
<div class="als-alert"><i class="warning-icon">&#9888;</i><span>{{ alert_banner }}</span></div>
{% endif %}
{% if outage_announcement %}
<div class="als-alert als-outage"><i class="warning-icon">&#128308;</i><span>服务中断进行中</span></div>
{% endif %}
{% for section in sections %}
<div class="als-section">
    <div class="als-section-head">
        <span class="als-section-name">{{ section.name }}</span>
        <span class="als-pill pill-{{ section.pill_class }}">{{ section.status_text }}</span>
    </div>
    {% for entry in section.entries %}
    <div class="als-row">
        <span class="dot" style="background:{{ entry.dot_color }}"></span>
        <span class="als-row-name">{{ entry.name }}</span>
        <span class="als-row-state {{ entry.state_class }}">{{ entry.status_text }}</span>
        <span class="als-row-rt">{{ entry.response_time }}</span>
    </div>
    {% endfor %}
</div>
{% endfor %}
<div class="footer">
    数据来源: apexlegendsstatus.com<br>
    auth.赤羽真白 · Apex Chiyuchan
</div>
</div>
</body>
</html>
