<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apex Legends 战绩</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,300;8..144,400;8..144,500;8..144,700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --md-primary: {{ theme.primary }};
  --md-on-primary: #FFFFFF;
  --md-primary-container: {{ theme.primary }}33;
  --md-on-primary-container: {{ theme.primary }};
  --md-surface: {{ theme.surface }};
  --md-on-surface: {{ theme.text }};
  --md-surface-variant: {{ theme.outline }};
  --md-on-surface-variant: {{ theme.muted }};
  --md-outline-variant: {{ theme.outline }};
  --md-surface-container-low: {{ theme.card }};
  --md-surface-container: {{ theme.card2 }};
  --md-surface-container-high: {{ theme.card3 }};
  --md-shadow-2: 0 10px 20px rgba(0,0,0,0.4);
}

body.light {
  --md-primary: {{ light_theme.primary }};
  --md-on-primary: #FFFFFF;
  --md-primary-container: {{ light_theme.primary }}22;
  --md-on-primary-container: {{ light_theme.primary }};
  --md-surface: #F8FAFF;
  --md-on-surface: #181B20;
  --md-surface-variant: #DDE3F0;
  --md-on-surface-variant: #43474F;
  --md-outline-variant: #C3C6CF;
  --md-surface-container-low: #EFF2F9;
  --md-surface-container: #E9ECF4;
  --md-surface-container-high: #E3E6EE;
  --md-shadow-2: 0 1px 2px rgba(0,0,0,0.3), 0 2px 6px 2px rgba(0,0,0,0.15);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Roboto Flex', 'Noto Sans SC', system-ui, sans-serif;
  background: transparent;
  color: var(--md-on-surface);
  display: flex;
  justify-content: center;
  padding: 24px;
  -webkit-font-smoothing: antialiased;
}

.card {
  width: 680px;
  background: var(--md-surface-container-low);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: var(--md-shadow-2);
  border: 1px solid color-mix(in srgb, var(--md-on-surface) 8%, transparent);
}

/* ---- Header ---- */
.header-bar {
  background: linear-gradient(135deg, var(--md-surface-container-low), var(--md-surface-container));
  padding: 20px 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid var(--md-outline-variant);
}

.avatar {
  width: 56px; height: 56px; border-radius: 50%; object-fit: cover;
  border: 3px solid var(--md-primary);
  box-shadow: 0 0 16px color-mix(in srgb, var(--md-primary) 25%, transparent);
}

.player-name { font-size: 22px; font-weight: 800; letter-spacing: 1px; }
.player-meta { font-size: 12px; color: var(--md-on-surface-variant); margin-top: 2px; }

.platform-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--md-surface-container-low);
  border: 1px solid var(--md-outline-variant);
  border-radius: 20px; padding: 4px 12px; font-size: 12px; margin-top: 4px;
}

.platform-tag .dot {
  display: inline-block; width: 8px; height: 8px; border-radius: 50%;
  background: {{ state_dot }};
}

/* ---- Rank ---- */
.rank-section {
  display: flex; align-items: center; padding: 16px 24px; gap: 16px;
  background: var(--md-surface-container);
  border-bottom: 1px solid var(--md-outline-variant);
}

.rank-img {
  width: 80px; height: 80px;
  filter: drop-shadow(0 4px 8px color-mix(in srgb, var(--md-primary) 25%, transparent));
}

.rank-tier { font-size: 28px; font-weight: 800; color: var(--md-primary); line-height: 1; }
.rank-rp { font-size: 14px; color: var(--md-on-surface-variant); margin-top: 4px; }

.rank-stats { display: flex; gap: 24px; text-align: center; margin-left: auto; }
.rank-stat-val { font-size: 18px; font-weight: 700; color: var(--md-primary); }
.rank-stat-label { font-size: 11px; color: var(--md-on-surface-variant); text-transform: uppercase; }

.rp-up { color: #4CE5B1; }
.rp-down { color: #DA292A; }

/* ---- Level ---- */
.level-row {
  display: flex; align-items: center; gap: 14px; padding: 14px 24px;
  border-bottom: 1px solid var(--md-outline-variant);
}

.level-icon {
  width: 64px; height: 64px; object-fit: contain; flex-shrink: 0;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));
}

.level-text {
  font-size: 20px; font-weight: 700;
  background: linear-gradient(135deg, var(--md-primary), #ff6b6b);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  white-space: nowrap;
}

.level-sub { font-size: 12px; color: var(--md-on-surface-variant); }

.level-bar {
  flex: 1; height: 6px;
  background: var(--md-surface-container-high); border-radius: 3px; overflow: hidden;
}

.level-fill {
  height: 100%; width: {{ level_pct }}%;
  background: linear-gradient(90deg, var(--md-primary), #ff6b6b);
  border-radius: 3px;
}

/* ---- Stat Grid ---- */
.stat-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--md-outline-variant);
}

.stat-chip {
  background: var(--md-surface-container-low); padding: 16px; text-align: center;
  display: flex; flex-direction: column; gap: 4px;
}

.stat-val { font-size: 22px; font-weight: 700; color: var(--md-on-surface); }
.stat-val.highlight { color: #FFD700; }
.stat-lbl { font-size: 11px; color: var(--md-on-surface-variant); text-transform: uppercase; letter-spacing: 0.5px; }

/* ---- Sections ---- */
.section-title {
  font-size: 14px; font-weight: 600; color: var(--md-on-surface-variant);
  text-transform: uppercase; letter-spacing: 2px; padding: 16px 24px 8px;
}

/* ---- Selected Legend ---- */
.selected-row {
  padding: 0 24px 8px; display: flex; align-items: center; gap: 12px;
}

.selected-icon {
  width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
  border: 2px solid var(--md-outline-variant);
}

.selected-name { font-size: 16px; font-weight: 600; }

.selected-stats { display: flex; gap: 8px; margin-left: auto; }

.selected-stat {
  margin-right: 24px;
}

.selected-stat-label { font-size: 11px; color: var(--md-on-surface-variant); display: block; }
.selected-stat-value { font-size: 14px; font-weight: 500; }

/* ---- Legend List ---- */
.legend-row {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 12px; border-radius: 8px; margin-bottom: 2px;
}

.legend-row.top1 {
  background: linear-gradient(135deg, color-mix(in srgb, var(--md-primary) 8%, transparent), transparent);
}

.legend-icon {
  width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
}

.legend-icon.top1 { border: 2px solid var(--md-primary); }
.legend-icon.normal { border: 2px solid var(--md-outline-variant); }

.legend-name { flex: 1; font-size: 14px; font-weight: 500; }
.legend-kills { font-size: 16px; font-weight: 700; }
.legend-kills.top1 { color: var(--md-primary); }

/* ---- Rank Distribution ---- */
.dist-bar-container { padding: 0 24px 16px; }

.dist-row {
  display: flex; align-items: center; gap: 8px;
  font-size: 11px; color: var(--md-on-surface-variant);
  margin-bottom: 4px;
}

.dist-name { width: 60px; text-align: right; flex-shrink: 0; }

.dist-bar-track {
  flex: 1; height: 8px; border-radius: 4px;
  background: var(--md-surface-container-high); overflow: hidden;
}

.dist-bar-fill { height: 100%; border-radius: 4px; }
.dist-count { width: 60px; text-align: right; flex-shrink: 0; }

/* ---- Badges ---- */
.badge-chip {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;
}

.badge-chip img { width: 36px; height: 36px; vertical-align: middle; }

.spec-badge {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; border-radius: 50%;
  background: color-mix(in srgb, var(--md-primary) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--md-primary) 25%, transparent);
}

.spec-badge img { width: 28px; height: 28px; display: block; }

/* ---- Footer ---- */
.footer {
  padding: 12px 24px;
  border-top: 1px solid var(--md-outline-variant);
  font-size: 11px; color: var(--md-on-surface-variant);
  display: flex; justify-content: space-between;
}

.footer a { color: var(--md-primary); text-decoration: none; font-weight: 600; }
</style>
</head>
<body class="{{ theme_class }}">
<div class="card">

  <div class="header-bar">
    <img class="avatar" src="{{ avatar_url }}" onerror="this.style.display='none'">
    <div>
      <div class="player-name">{{ display_name }}</div>
      <div class="player-meta">{% if alias %}aka {{ alias }} · {% endif %}UID: {{ uid }}</div>
      <div class="platform-tag"><span class="dot"></span>{{ platform }} · {{ state_text }}</div>
    </div>
  </div>

  <div class="rank-section">
    <img class="rank-img" src="{{ rank_img }}" onerror="this.remove()">
    <div>
      <div class="rank-tier">{{ rank_display }}</div>
      <div class="rank-rp">{{ rank_score_fmt }} RP{{ rp_delta_html }}</div>
    </div>
    <div class="rank-stats">
      <div>
        <div class="rank-stat-val">{{ top_global }}</div>
        <div class="rank-stat-label">Top ({{ top_pct_label }})</div>
      </div>
    </div>
  </div>

  <div class="level-row">
    <img class="level-icon" src="{{ level_icon }}" onerror="this.style.display='none'">
    <div style="flex:1;display:flex;flex-direction:column;gap:4px;">
      <div class="level-text">{{ level }}</div>
      <div class="level-bar"><div class="level-fill"></div></div>
      <div class="level-sub">{{ level_pct }}% to next level</div>
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat-chip">
      <div class="stat-val highlight">{{ kills_fmt }}</div>
      <div class="stat-lbl">生涯击杀</div>
    </div>
    <div class="stat-chip">
      <div class="stat-val">{{ damage_fmt }}</div>
      <div class="stat-lbl">BR 总伤害</div>
    </div>
    <div class="stat-chip">
      <div class="stat-val">{{ wins_fmt }}</div>
      <div class="stat-lbl">BR 胜场</div>
    </div>
  </div>

  {% if selected_legend %}
  <div class="section-title">当前选用</div>
  <div class="selected-row">
    {% if selected_legend.icon_url %}
    <img class="selected-icon" src="{{ selected_legend.icon_url }}" onerror="this.remove()">
    {% endif %}
    <span class="selected-name">{{ selected_legend.name_zh }}</span>
    <div class="selected-stats">
      {% for s in selected_legend.stats %}
      <div class="selected-stat">
        <span class="selected-stat-label">{{ s.name }}</span>
        <span class="selected-stat-value">{{ s.value }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="section-title">段位分布参考 (全平台)</div>
  <div class="dist-bar-container">
    {% for d in rank_dist %}
    <div class="dist-row">
      <span class="dist-name">{{ d.name }}</span>
      <div class="dist-bar-track">
        <div class="dist-bar-fill" style="width:{{ d.pct }}%;background:{{ d.color }};"></div>
      </div>
      <span class="dist-count">{{ d.count_fmt }}</span>
    </div>
    {% endfor %}
  </div>

  <div class="section-title">常用英雄</div>
  <div style="padding:0 24px 16px;">
    {% if top_legends %}
      {% for leg in top_legends %}
      <div class="legend-row {{ 'top1' if loop.first else '' }}">
        {% if leg.icon_url %}
        <img class="legend-icon {{ 'top1' if loop.first else 'normal' }}" src="{{ leg.icon_url }}" onerror="this.remove()">
        {% else %}
        <div class="legend-icon" style="background:var(--md-surface-container-high);"></div>
        {% endif %}
        <span class="legend-name">{{ leg.name_zh }}</span>
        <span class="legend-kills {{ 'top1' if loop.first else '' }}">{{ leg.kills_fmt }}</span>
      </div>
      {% endfor %}
    {% else %}
      <div style="color:var(--md-on-surface-variant);font-size:13px;">暂无英雄数据</div>
    {% endif %}
  </div>

  {% if season_badges %}
  <div class="section-title">Ranked 赛季徽章</div>
  <div style="display:flex;flex-wrap:wrap;gap:8px;padding:0 24px 12px;justify-content:center;">
    {% for b in season_badges %}
    <span class="badge-chip" style="background:{{ b.bg }};color:{{ b.color }};border:1px solid {{ b.border }};">
      {% if b.badge_url %}<img src="{{ b.badge_url }}" onerror="this.remove()">{% endif %}{{ b.season }}
    </span>
    {% endfor %}
  </div>
  {% endif %}

  {% if special_badges %}
  <div class="section-title">特殊徽章</div>
  <div style="display:flex;flex-wrap:wrap;gap:8px;padding:0 24px 16px;justify-content:center;">
    {% for b in special_badges %}
    <span class="spec-badge">
      {% if b.badge_url %}<img src="{{ b.badge_url }}" onerror="this.remove()">{% endif %}
    </span>
    {% endfor %}
  </div>
  {% endif %}

  <div class="footer">
    <span>Data: <a href="https://apexlegendsstatus.com" target="_blank">Apex Legends Status</a></span>
    <span>auth.赤羽真白 · Apex Chiyuchan</span>
    <span>UID: {{ uid }}</span>
  </div>

</div>
</body>
</html>
