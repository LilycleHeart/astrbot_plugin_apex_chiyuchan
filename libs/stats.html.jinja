<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>Apex Legends 战绩</title>
{% if not local_fonts %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@500;700;900&display=swap" rel="stylesheet">
{% endif %}
<style>
{{ font_css }}
{% include "card_base.css" %}

/* ═══ 头部：段位主色只用在这一块 ═══ */
.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 22px 24px 20px;
  background:
    radial-gradient(120% 95% at 0% 0%, color-mix(in srgb, var(--tier) 30%, transparent) 0%, transparent 62%),
    linear-gradient(180deg, color-mix(in srgb, var(--tier) 13%, var(--bg)) 0%, var(--bg) 100%);
}
body.light .hero {
  background:
    radial-gradient(120% 95% at 0% 0%, color-mix(in srgb, var(--tier) 30%, transparent) 0%, transparent 62%),
    linear-gradient(180deg, color-mix(in srgb, var(--tier) 14%, #fff) 0%, var(--bg) 100%);
}
.hero::before {
  content: "";
  position: absolute; inset: 0; z-index: -2;
  background: repeating-linear-gradient(115deg, color-mix(in srgb, var(--text) 5%, transparent) 0 1px, transparent 1px 11px);
  -webkit-mask-image: linear-gradient(100deg, transparent 0%, #000 35%, #000 55%, transparent 85%);
  mask-image: linear-gradient(100deg, transparent 0%, #000 35%, #000 55%, transparent 85%);
}
.hero-art {
  position: absolute; z-index: -1;
  right: -40px; top: 6px;
  height: 236px; width: auto;
  -webkit-mask-image: radial-gradient(60% 72% at 60% 40%, #000 40%, transparent 100%);
  mask-image: radial-gradient(60% 72% at 60% 40%, #000 40%, transparent 100%);
  filter: grayscale(1) contrast(1.1);
  mix-blend-mode: luminosity;
  opacity: .44;
}
body.light .hero-art { mix-blend-mode: multiply; opacity: .26; }

.id { display: flex; align-items: center; gap: 12px; }
.avatar {
  width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--tier) 75%, transparent), 0 4px 14px rgba(0,0,0,.25);
}
.id-text { min-width: 0; }
.name {
  display: flex; align-items: center; gap: 8px;
  font-size: 20px; font-weight: 800; line-height: 1.2;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  max-width: 460px;
}
.tag {
  font-size: 11px; font-weight: 700; letter-spacing: .5px;
  padding: 2px 7px; border-radius: 6px;
  color: var(--accent);
  background: color-mix(in srgb, var(--tier) 16%, transparent);
}
.meta { display: flex; align-items: center; gap: 7px; margin-top: 4px; font-size: 12px; color: var(--text-2); }
.meta .sep { width: 3px; height: 3px; border-radius: 50%; background: var(--text-3); }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--text-3); }
.dot.on { background: var(--up); box-shadow: 0 0 0 3px color-mix(in srgb, var(--up) 22%, transparent); }
.dot.game { background: var(--warn); box-shadow: 0 0 0 3px color-mix(in srgb, var(--warn) 22%, transparent); }

.using {
  margin-left: auto; align-self: flex-start;
  display: flex; align-items: center; gap: 4px;
  height: 24px; padding: 0 9px; border-radius: 7px;
  font-size: 11.5px; font-weight: 700; color: var(--text);
  background: color-mix(in srgb, var(--bg) 55%, transparent);
  border: 1px solid var(--line-2);
}
.using .ic { font-size: 14px; color: var(--accent); }

.rank { display: flex; align-items: center; gap: 18px; margin-top: 16px; }
.emblem { position: relative; width: 132px; height: 132px; flex-shrink: 0; }
.emblem img {
  width: 100%; height: 100%; object-fit: contain;
  filter: drop-shadow(0 0 18px color-mix(in srgb, var(--tier) 50%, transparent)) drop-shadow(0 6px 10px rgba(0,0,0,.35));
}
body.light .emblem img {
  filter: drop-shadow(0 0 14px color-mix(in srgb, var(--tier) 40%, transparent)) drop-shadow(0 6px 10px rgba(0,0,0,.18));
}
.plate {
  position: absolute; left: 50%; transform: translate(-50%, -50%);
  font-size: 19px; font-weight: 700; letter-spacing: 1px; line-height: 1;
  color: #FFF; text-shadow: 0 0 8px color-mix(in srgb, var(--tier) 80%, transparent);
}
.plate.pos { font-size: 14px; letter-spacing: .3px; }

.rank-info { min-width: 0; }
.tier-name { font-size: 24px; font-weight: 900; line-height: 1.15; color: var(--accent); letter-spacing: 1px; }
.rp-line { display: flex; align-items: baseline; gap: 6px; margin-top: 2px; }
.rp { font-size: 68px; font-weight: 700; line-height: .92; letter-spacing: -.5px; }
.rp-unit { font-family: var(--num); font-size: 20px; font-weight: 700; color: var(--text-2); }
.rp-delta { font-family: var(--num); font-size: 18px; font-weight: 700; margin-left: 6px; }
.chips { display: flex; gap: 6px; margin-top: 10px; }

/* 段位进度条 */
.ladder { margin-top: 16px; }
.ladder-head { display: flex; align-items: baseline; justify-content: space-between; font-size: 13px; color: var(--text-2); }
.ladder-head b { color: var(--text); font-weight: 800; }
.ladder-head .goal .num { font-size: 18px; color: var(--accent); margin: 0 1px; }
.ladder-head .now { font-size: 14px; }
.ladder-head .now em { font-style: normal; color: var(--text-3); }
.bar {
  position: relative; height: 10px; margin-top: 7px; border-radius: 5px;
  background: color-mix(in srgb, var(--text) 10%, transparent);
}
.bar .fill {
  position: absolute; left: 0; top: 0; bottom: 0; border-radius: 5px;
  background: linear-gradient(90deg, color-mix(in srgb, var(--tier) 45%, transparent), var(--tier));
  box-shadow: 0 0 12px color-mix(in srgb, var(--tier) 45%, transparent);
}
body.light .bar .fill { background: linear-gradient(90deg, color-mix(in srgb, var(--tier) 55%, #fff), var(--tier-deep)); box-shadow: none; }
.bar .tick { position: absolute; top: -1px; bottom: -1px; width: 3px; margin-left: -1.5px; background: var(--bg); }
.bar .knob {
  position: absolute; top: 50%; width: 16px; height: 16px; margin-left: -8px; transform: translateY(-50%);
  border-radius: 50%; background: #FFF;
  box-shadow: 0 0 0 3px var(--tier), 0 0 14px color-mix(in srgb, var(--tier) 70%, transparent);
}
body.light .bar .knob { box-shadow: 0 0 0 3px var(--tier-deep), 0 2px 6px rgba(0,0,0,.2); }
.bar-labels { position: relative; height: 16px; margin-top: 6px; font-size: 11px; font-weight: 700; color: var(--text-3); }
.bar-labels span { position: absolute; transform: translateX(-50%); font-family: var(--num); font-size: 13px; letter-spacing: .5px; }
.bar-labels span.cur { color: var(--accent); }
.bar-labels .edge-l { left: 0; transform: none; font-family: var(--sans); font-size: 11px; }
.bar-labels .edge-r { right: 0; left: auto; transform: none; font-family: var(--sans); font-size: 11px; }

.elite {
  display: flex; align-items: center; gap: 10px; margin-top: 16px;
  padding: 10px 14px; border-radius: 12px;
  background: color-mix(in srgb, var(--bg) 50%, transparent);
  border: 1px solid var(--line-2);
  font-size: 13px; color: var(--text-2);
}
.elite .ic { font-size: 18px; color: var(--accent); }
.elite b { margin-left: auto; font-family: var(--num); font-size: 26px; font-weight: 700; color: var(--text); line-height: 1; }

/* ═══ 生涯数据 ═══ */
.tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 4px 24px 20px; }
.tile { position: relative; padding: 12px 14px 13px; border-radius: 14px; background: var(--bg-2); }
.t-label { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--text-2); }
.t-label .ic { font-size: 14px; color: var(--text-3); }
.t-val { margin-top: 7px; font-size: 31px; font-weight: 700; line-height: 1; }
.t-val small { margin-left: 2px; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--text-2); }
.t-sub { position: absolute; right: 14px; top: 12px; font-family: var(--num); font-size: 13px; font-weight: 600; color: var(--text-3); }
.t-bar { height: 4px; margin-top: 8px; border-radius: 2px; background: var(--bg-3); overflow: hidden; }
.t-bar i { display: block; height: 100%; border-radius: 2px; background: var(--accent); }

/* ═══ RP 走势 ═══ */
.chart { position: relative; }
.chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.chart text { font-family: var(--num); }
.chart text.halo { paint-order: stroke; stroke: var(--bg); stroke-width: 5px; stroke-linejoin: round; }
.chart .tl line { stroke: var(--c); stroke-opacity: .6; }
.chart .tl text { fill: var(--c); font-family: var(--sans); }
body.light .chart .tl line { stroke: var(--cd); stroke-opacity: .5; }
body.light .chart .tl text { fill: var(--cd); }
.chart .promo {
  position: absolute; width: 26px; height: 26px; border-radius: 7px; padding: 1px;
  background: var(--bg); box-shadow: 0 1px 4px rgba(0,0,0,.3);
}

/* ═══ 常用传奇 ═══ */
.legs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.leg { position: relative; isolation: isolate; height: 100px; border-radius: 14px; overflow: hidden; background: var(--bg-2); }
.leg.top { background: linear-gradient(150deg, color-mix(in srgb, var(--tier) 24%, var(--bg-2)) 0%, var(--bg-2) 70%); }
.leg-art {
  position: absolute; z-index: -2; right: -24px; top: -6px; height: 120px; width: auto;
  -webkit-mask-image: linear-gradient(to left, #000 50%, transparent 100%);
  mask-image: linear-gradient(to left, #000 50%, transparent 100%);
}
.leg::after {
  content: ""; position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(0deg, color-mix(in srgb, var(--bg-2) 92%, transparent) 0%, transparent 62%);
}
.leg-info { position: absolute; left: 14px; bottom: 11px; }
.leg-name { font-size: 15px; font-weight: 800; }
.leg-kills { margin-top: 1px; font-size: 12px; color: var(--text-2); }
.leg-kills b { margin-right: 4px; font-family: var(--num); font-size: 25px; font-weight: 700; color: var(--text); }
.leg-rank { position: absolute; left: 12px; top: 10px; font-family: var(--num); font-size: 13px; font-weight: 700; color: var(--text-3); }
.leg.top .leg-rank { color: var(--accent); }
.leg-tag {
  position: absolute; right: 8px; top: 8px; height: 20px; padding: 0 7px; border-radius: 6px;
  display: flex; align-items: center; font-size: 11px; font-weight: 700;
  color: var(--accent); background: color-mix(in srgb, var(--bg) 70%, transparent);
}

/* ═══ 赛季足迹 ═══ */
.tsum { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
.tsum i { width: 8px; height: 8px; border-radius: 2px; transform: rotate(45deg); background: var(--c); }
body.light .tsum i { background: var(--cd); }
.tsum b { font-family: var(--num); font-size: 14px; color: var(--text); }
.badges { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 6px 2px; }
.sb { width: 46px; display: flex; flex-direction: column; align-items: center; gap: 3px; }
.sb img { width: 38px; height: 38px; object-fit: contain; }
.sb span { font-family: var(--num); font-size: 12px; font-weight: 600; color: var(--text-2); line-height: 1; }
.badge-sep { width: 1px; height: 38px; margin: 0 8px 8px auto; background: var(--line-2); }
.sp { width: 42px; height: 53px; display: flex; align-items: flex-start; justify-content: center; }
.sp img { width: 38px; height: 38px; object-fit: contain; }

/* ═══ 段位分布 ═══ */
.hist { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; align-items: end; }
.hcol { display: flex; flex-direction: column; align-items: stretch; }
.hbar { height: 92px; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 5px; }
.hbar i { display: block; width: 100%; min-height: 3px; border-radius: 6px 6px 3px 3px; background: var(--c); opacity: .5; }
body.light .hbar i { background: var(--cd); opacity: .3; }
.hpct { font-size: 13px; font-weight: 600; color: var(--text-2); line-height: 1; }
.hname { margin-top: 6px; text-align: center; font-size: 12px; color: var(--text-2); }
.hcol.me .hbar i { opacity: 1; box-shadow: 0 0 16px color-mix(in srgb, var(--c) 55%, transparent); }
body.light .hcol.me .hbar i { opacity: 1; box-shadow: none; }
.hcol.me .hpct, .hcol.me .hname { color: var(--text); font-weight: 800; }
.me-pin {
  height: 18px; padding: 0 6px; border-radius: 5px;
  display: flex; align-items: center; font-size: 11px; font-weight: 800;
  color: var(--bg); background: var(--accent);
}
</style>
</head>
<body class="{{ theme_class }}" style="--tier:{{ tier.bright }};--tier-deep:{{ tier.deep }};">
<div class="card stats">

  <!-- ═══ 头部：身份 + 段位 + 进度 ═══ -->
  <section class="hero">
    {% if hero_art %}<img class="hero-art" src="{{ hero_art }}" onerror="this.remove()">{% endif %}

    <div class="id">
      {% if avatar_url %}<img class="avatar" src="{{ avatar_url }}" onerror="this.style.visibility='hidden'">{% endif %}
      <div class="id-text">
        <div class="name">{{ name }}{% if tag %}<span class="tag">{{ tag }}</span>{% endif %}</div>
        <div class="meta">
          <i class="dot {{ state_class }}"></i><span>{{ state_text }}</span>
          <b class="sep"></b><span>{{ platform }}</span>
          {% if alias %}<b class="sep"></b><span>aka {{ alias }}</span>{% endif %}
          <b class="sep"></b><span>UID {{ uid }}</span>
        </div>
      </div>
      {% if selected_name %}<div class="using">{{ icons.person }}<span>{{ selected_name }}</span></div>{% endif %}
    </div>

    <div class="rank">
      <div class="emblem">
        {% if emblem %}<img src="{{ emblem }}" onerror="this.remove()">{% endif %}
        {% if plate_text %}<span class="plate num{% if plate_is_pos %} pos{% endif %}" style="top:{{ plate_y }}%">{{ plate_text }}</span>{% endif %}
      </div>
      <div class="rank-info">
        <div class="tier-name">{{ tier_name }}</div>
        <div class="rp-line"><span class="rp num">{{ rank_score_fmt }}</span><span class="rp-unit">RP</span>{{ rp_delta_html }}</div>
        <div class="chips">{{ rp_trend_html }}{% if top_text %}<span class="chip">{{ icons.leaderboard }}{{ top_text }}</span>{% endif %}</div>
      </div>
    </div>

    {% if ladder %}
    <div class="ladder">
      <div class="ladder-head">
        <span class="goal">距 <b>{{ ladder.target_name }}</b> 还差 <b class="num">{{ ladder.remaining_fmt }}</b> RP</span>
        <span class="now num">{{ rank_score_fmt }} <em>/ {{ ladder.end_fmt }}</em></span>
      </div>
      <div class="bar">
        <i class="fill" style="width:{{ ladder.fill }}%"></i>
        {% for s in ladder.segments[1:] %}<b class="tick" style="left:{{ s.left }}%"></b>{% endfor %}
        <span class="knob" style="left:{{ ladder.fill }}%"></span>
      </div>
      <div class="bar-labels">
        {% if ladder.segments %}
          {% for s in ladder.segments %}<span class="{{ 'cur' if s.current else '' }}" style="left:{{ s.left + s.width / 2 }}%">{{ s.label }}</span>{% endfor %}
        {% else %}
          <span class="edge-l">{{ tier_zh }} {{ ladder.start_fmt }}</span>
          <span class="edge-r">{{ ladder.end_name }} {{ ladder.end_fmt }}</span>
        {% endif %}
      </div>
    </div>
    {% elif elite_pos %}
    <div class="elite">{{ icons.leaderboard }}<span>{{ elite_label }}</span><b>{{ elite_pos }}</b></div>
    {% endif %}
  </section>

  <!-- ═══ 生涯数据 ═══ -->
  <section class="tiles">
    <div class="tile">
      <div class="t-label">{{ icons.gps_fixed }}生涯击杀</div>
      <div class="t-val num">{{ kills_fmt }}</div>
    </div>
    <div class="tile">
      <div class="t-label">{{ icons.bolt }}BR 总伤害</div>
      <div class="t-val num">{{ damage_fmt }}{% if damage_unit %}<small>{{ damage_unit }}</small>{% endif %}</div>
    </div>
    <div class="tile">
      <div class="t-label">{{ icons.emoji_events }}BR 胜场</div>
      <div class="t-val num">{{ wins_fmt }}</div>
    </div>
    <div class="tile">
      <div class="t-label">{{ icons.star }}等级</div>
      <span class="t-sub">{{ level_pct }}%</span>
      <div class="t-val num">{{ level }}</div>
      <div class="t-bar"><i style="width:{{ level_pct }}%"></i></div>
    </div>
  </section>

  <!-- ═══ RP 走势 ═══ -->
  {{ rp_chart_html }}

  <!-- ═══ 常用传奇 ═══ -->
  {% if top_legends %}
  <section class="block">
    <div class="block-head">
      <span class="block-title">{{ icons.group }}常用传奇</span>
      <span class="block-meta">按击杀排序</span>
    </div>
    <div class="legs">
      {% for leg in top_legends %}
      <div class="leg{% if loop.first %} top{% endif %}">
        {% if leg.icon_url %}<img class="leg-art" src="{{ leg.icon_url }}" onerror="this.remove()">{% endif %}
        <span class="leg-rank">#{{ loop.index }}</span>
        {% if leg.selected %}<span class="leg-tag">使用中</span>{% endif %}
        <div class="leg-info">
          <div class="leg-name">{{ leg.name_zh }}</div>
          <div class="leg-kills"><b>{{ leg.kills_fmt }}</b>击杀</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- ═══ 赛季足迹 ═══ -->
  {% if season_badges or special_badges %}
  <section class="block">
    <div class="block-head">
      <span class="block-title">{{ icons.military_tech }}赛季足迹</span>
      <span class="block-meta">
        {% for t in season_summary %}<span class="tsum" style="--c:{{ t.bright }};--cd:{{ t.deep }};"><i></i>{{ t.zh }}<b>{{ t.count }}</b></span>{% endfor %}
      </span>
    </div>
    <div class="badges">
      {% for b in season_badges %}
      <div class="sb">{% if b.badge_url %}<img src="{{ b.badge_url }}" onerror="this.remove()">{% endif %}<span>{{ b.season }}</span></div>
      {% endfor %}
      {% if season_badges and special_badges %}<i class="badge-sep"></i>{% endif %}
      {% for b in special_badges %}
      <div class="sp">{% if b.badge_url %}<img src="{{ b.badge_url }}" onerror="this.remove()">{% endif %}</div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- ═══ 段位分布 ═══ -->
  {% if rank_hist %}
  <section class="block">
    <div class="block-head">
      <span class="block-title">{{ icons.bar_chart }}段位分布</span>
      <span class="block-meta">全平台{% if rank_total %} · {{ rank_total }}人{% endif %}</span>
    </div>
    <div class="hist">
      {% for h in rank_hist %}
      <div class="hcol{% if h.me %} me{% endif %}" style="--c:{{ h.bright }};--cd:{{ h.deep }};">
        <div class="hbar">
          {% if h.me %}<span class="me-pin">你</span>{% endif %}
          <span class="hpct num">{{ h.pct }}%</span>
          <i style="height:{{ h.height }}px"></i>
        </div>
        <span class="hname">{{ h.zh }}</span>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <footer class="foot">数据 <b>apexlegendsstatus.com</b> · 由于游戏限制数据仅供参考 · auth.赤羽真白 · Apex Chiyuchan</footer>
</div>
</body>
</html>
